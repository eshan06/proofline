# Proofline environment configuration. Copy to `.env.local` for local dev.

# --- Database ------------------------------------------------------------
# When set, the app uses Postgres (real persistence + auth required). When
# unset, it runs entirely in-memory (zero-setup dev / demo). pgvector required.
#   local docker: docker run -d --name pl-postgres -e POSTGRES_PASSWORD=proofline \
#     -e POSTGRES_DB=proofline -p 5432:5432 pgvector/pgvector:pg16
# DATABASE_URL=postgres://postgres:proofline@localhost:5432/proofline
# Managed Postgres (RDS/Supabase/Neon) example — note ?sslmode=require:
# DATABASE_URL=postgresql://user:pass@your-instance.rds.amazonaws.com:5432/proofline?sslmode=require
# DB_POOL_MAX=10
# TLS: auto (off for localhost, on for remote without strict CA verify). Override
# with DB_SSL=disable (force off) or DB_SSL=verify (strict; set NODE_EXTRA_CA_CERTS).
# DB_SSL=
# EMBEDDING_DIM=384            # changing this requires re-indexing the KB

# --- AI provider ---------------------------------------------------------
# Which DraftProvider backs the copilot. The UI is provider-agnostic.
#   mock      (default) fixture-backed, deterministic, no network calls
#   anthropic real provider (requires ANTHROPIC_API_KEY; wire up in src/server/ai/index.ts)
#   openai    real provider (requires OPENAI_API_KEY; wire up in src/server/ai/index.ts)
AI_PROVIDER=mock

# Required only when AI_PROVIDER selects a real provider.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Model id for the real provider (optional; provider picks a sensible default).
# AI_MODEL=claude-opus-4-8

# Embedding provider for RAG retrieval (local | openai | voyage). 'local' needs
# no key (hashed lexical vectors); set a real one for production retrieval quality.
EMBEDDINGS_PROVIDER=local
# LLM used to draft the grounded reply (template | anthropic | openai).
LLM_PROVIDER=template

# --- Email (transactional) ----------------------------------------------
# console (default, logs only) | resend | postmark | ses
EMAIL_PROVIDER=console
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=

# --- Billing -------------------------------------------------------------
# mock (default) | stripe
BILLING_PROVIDER=mock
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Demo sandbox --------------------------------------------------------
# Max AI calls per demo session before the signup CTA gates further drafting.
# DEMO_AI_CALL_LIMIT=25

# --- Security / rate limiting --------------------------------------------
# Number of trusted reverse proxies in front of the app (e.g. 1 for a single
# ALB / Vercel edge). The client IP for rate limiting is read this many hops
# from the right of x-forwarded-for, so a client can't spoof a fresh bucket by
# prepending a fake address. Leave unset to trust only the nearest hop.
# RATE_LIMIT_PROXY_HOPS=1

# --- App -----------------------------------------------------------------
# Public base URL. Used for absolute links, OAuth callbacks, and the website
# chat widget embed snippet (Integrations → Website Chat). Set in production.
# NEXT_PUBLIC_APP_URL=https://app.proofline.com
