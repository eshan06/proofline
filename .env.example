# Proofline environment configuration. Copy to `.env.local` for local dev.

# --- Database ------------------------------------------------------------
# When set, the app uses Postgres (real persistence + auth required). When
# unset, it runs entirely in-memory (zero-setup dev / demo). pgvector required.
#   local docker: docker run -d --name pl-postgres -e POSTGRES_PASSWORD=proofline \
#     -e POSTGRES_DB=proofline -p 5432:5432 pgvector/pgvector:pg16
# DATABASE_URL=postgres://postgres:proofline@localhost:5432/proofline
# Managed Postgres (RDS/Supabase/Neon) example — note ?sslmode=require:
# DATABASE_URL=postgresql://user:pass@your-instance.rds.amazonaws.com:5432/proofline?sslmode=require
# DB_POOL_MAX=10
# TLS: auto (off for localhost, on for remote without strict CA verify). Override
# with DB_SSL=disable (force off) or DB_SSL=verify (strict). For strict verification,
# set DB_CA_CERT to the provider's CA-bundle PEM (e.g. the Amazon RDS global bundle;
# \n-escaped is fine) — then the cert is verified without NODE_EXTRA_CA_CERTS.
# DB_SSL=
# DB_CA_CERT=
# EMBEDDING_DIM=384            # changing this requires re-indexing the KB

# --- AI provider ---------------------------------------------------------
# Which DraftProvider backs the copilot. The UI is provider-agnostic.
#   mock      (default) fixture-backed, deterministic, no network calls
#   anthropic real provider (requires ANTHROPIC_API_KEY; wire up in src/server/ai/index.ts)
#   openai    real provider (requires OPENAI_API_KEY; wire up in src/server/ai/index.ts)
AI_PROVIDER=mock

# Required only when AI_PROVIDER selects a real provider.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Model id for the real provider (optional; provider picks a sensible default).
# AI_MODEL=claude-opus-4-8

# Embedding provider for RAG retrieval (local | openai | voyage). 'local' needs
# no key (hashed lexical vectors, free). 'openai' uses OPENAI_API_KEY +
# text-embedding-3-small, requesting EMBEDDING_DIM-length vectors so no schema
# change is needed — but SWITCHING providers requires re-indexing the KB
# (lexical and semantic vector spaces differ). voyage is a documented stub.
EMBEDDINGS_PROVIDER=local
# EMBEDDINGS_MODEL=text-embedding-3-small
# LLM used to draft the grounded reply (template | anthropic | openai).
LLM_PROVIDER=template

# --- Email (transactional) ----------------------------------------------
# console (default, logs only) | resend (wired) | postmark | ses (stubs)
# With resend, set both RESEND_API_KEY and EMAIL_FROM (a verified sender).
EMAIL_PROVIDER=console
# RESEND_API_KEY=
# EMAIL_FROM="Proofline <support@yourdomain.com>"
# POSTMARK_SERVER_TOKEN=

# --- Gmail channel (inbound + outbound email) ----------------------------
# Dormant until set: with no client id/secret the channel is disabled and the
# app runs normally. To activate, create a Google Cloud OAuth client (type: Web),
# enable the Gmail API, and add the redirect URI below to the client's allowed
# redirects. An admin then connects their support mailbox in Integrations → Gmail.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# Defaults to ${NEXT_PUBLIC_APP_URL}/api/integrations/gmail/callback if unset.
# GMAIL_REDIRECT_URI=
# Shared secret so a scheduler can poll inbound without a user session:
#   POST /api/integrations/gmail/poll?workspaceId=… with header x-gmail-poll-secret.
# GMAIL_POLL_SECRET=

# --- Slack channel (inbound + outbound) ----------------------------------
# Dormant until set. Create a Slack app: add a Bot Token with scopes
# channels:history, groups:history, im:history, chat:write, users:read; enable
# the Events API with request URL ${NEXT_PUBLIC_APP_URL}/api/integrations/slack/events
# and subscribe to message.channels; enable OAuth with redirect
# ${NEXT_PUBLIC_APP_URL}/api/integrations/slack/callback. SLACK_SIGNING_SECRET
# verifies inbound events; SLACK_CLIENT_ID/SECRET drive the install flow.
# SLACK_SIGNING_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# Defaults to ${NEXT_PUBLIC_APP_URL}/api/integrations/slack/callback if unset.
# SLACK_REDIRECT_URI=

# --- Billing -------------------------------------------------------------
# mock (default) | stripe. With stripe, set the secret + webhook signing secret
# and the price ids for each plan (point your Stripe webhook at /api/billing/webhook).
BILLING_PROVIDER=mock
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_GROWTH=price_...
# STRIPE_PRICE_SCALE=price_...

# --- Demo sandbox --------------------------------------------------------
# Max AI calls per demo session before the signup CTA gates further drafting.
# DEMO_AI_CALL_LIMIT=25

# --- Security / rate limiting --------------------------------------------
# Number of trusted reverse proxies in front of the app (e.g. 1 for a single
# ALB / Vercel edge). The client IP for rate limiting is read this many hops
# from the right of x-forwarded-for, so a client can't spoof a fresh bucket by
# prepending a fake address. Leave unset to trust only the nearest hop.
# RATE_LIMIT_PROXY_HOPS=1

# Error alerts: when set, unhandled server errors POST a one-line alert here
# (Slack/Discord/any incoming webhook) in addition to structured error logs.
# ERROR_WEBHOOK_URL=https://hooks.slack.com/services/...

# Error tracking (Sentry, etc.): the logger exposes setErrorSink() and
# instrumentation.ts shows where to init the SDK. SENTRY_DSN is read there once
# you install @sentry/nextjs and uncomment the wiring.
# SENTRY_DSN=

# Distributed rate limiting across instances. Without these, the limiter is
# in-process (correct for a single instance; per-instance on multiple replicas).
# Point at an Upstash Redis REST endpoint (dep-free; uses the REST API):
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# --- App -----------------------------------------------------------------
# Public base URL. Used for absolute links, OAuth callbacks, and the website
# chat widget embed snippet (Integrations → Website Chat). Set in production.
# NEXT_PUBLIC_APP_URL=https://app.proofline.com
